{"_data": [{"type": "metadata", "contents": [{"content": "Solving Problems", "type": "lesson_name"}, {"content": "The Business Lunch", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "Beginner", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "target_word", "contents": [{"content": "Could you do me a favor? ", "type": "name"}, {"content": "request help in a polite way", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Could you do me a favor and copy these documents?", "type": "example"}, {"content": "engenn1le05ob05aud05", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you read or hear at work when someone needs help.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to order", "type": "name"}, {"content": "to call a restaurant and have them send food", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Call Marco's Restaurant and order lunch for our guests.", "type": "example"}, {"content": "engenn1le05ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "please get ...", "type": "name"}, {"content": "a polite request to order or pick up food", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Please, get me a sandwich and some tea.", "type": "example"}, {"content": "engenn1le05ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "I am happy to", "type": "name"}, {"content": "this is not a problem for me to do", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I am happy to take him to the airport.", "type": "example"}, {"content": "engenn1le05ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "boardroom", "type": "name"}, {"content": "a room for meetings at work", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The meeting is tomorrow in the boardroom.", "type": "example"}, {"content": "engenn1le05ob05aud01", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": " Asking for and Offering Help With Can and Could", "type": "heading"}, {"content": "When you want to ask for help, use the phrases:<br /><span class=\"italic\"> Can you + action ... ? or Could you + action ... ?</span><br />When you want to offer help, use the phrase:<span class=\"italic\"> I can + action ...</span>", "type": "describer"}, {"content": "Can you get lunch today? <br>Could you do me a favor?", "type": "example"}, {"content": "I can help you.  <br> I can order lunch.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Can for Permission", "type": "heading"}, {"content": "To ask for or give permission, you use the modal verb <span class=\"italic\"> can</span>.", "type": "describer"}, {"content": "{\"rows\":\"2\",\"columns\":\"2\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Ask or Give Permission </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Respond</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Can I use this book? <br /> <br />You can use the company car. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Yes, you can. <br /> <br />Thank you. </span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "objectives", "contents": [{"content": "Accurately use basic information in simple situations.", "type": "primary"}, {"content": "Understands basic information in English texts according to the communicative topics of this level.", "type": "secondary